# Public application origin. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Added in Milestone 2. Use a dedicated, non-production Neon branch locally.
DATABASE_URL=postgresql://serviceflow:serviceflow@localhost:5432/serviceflow

# Added in Milestone 3. Generate a unique value; never commit the real secret.
AUTH_SECRET=replace-with-a-long-random-value

# Demo-only controls default to off and must be explicitly enabled.
DEMO_AUTH_ENABLED=false
DEMO_RESET_ENABLED=false

# Server-only reset credential. Never prefix this variable with NEXT_PUBLIC_.
DEMO_RESET_SECRET=replace-with-a-long-random-value
